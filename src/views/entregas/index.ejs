<section class="page-header">
    <div>
        <h2>Entregas</h2>
        <p>Gerencie e acompanhe suas entregas.</p>
    </div>

    <a href="/entregas/nova" class="btn btn-primary">
        + Nova Entrega
    </a>
</section>

<div class="card">
    <form action="/entregas" method="GET">
        <label for="status">Filtrar por status:</label>

        <select name="status" id="status">
            <option value="">Todas as entregas</option>
            <option value="CRIADA">Criada</option>
            <option value="EM_TRANSITO">Em trânsito</option>
            <option value="ENTREGUE">Entregue</option>
            <option value="CANCELADA">Cancelada</option>
        </select>

        <button type="submit" class="btn btn-primary">
            Filtrar
        </button>
    </form>
</div>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Descrição</th>
                <th>Origem</th>
                <th>Destino</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            <% if (entregas.length > 0) { %>
  <% entregas.forEach((entrega) => { %>
    <tr>
      <td><%= entrega.id %></td>
      <td><%= entrega.descricao %></td>
      <td><%= entrega.origem %></td>
      <td><%= entrega.destino %></td>
      <td><%= entrega.status %></td>
      <td>
        <a href="/entregas/<%= entrega.id %>" class="btn btn-secondary">
          Detalhes
        </a>
      </td>
    </tr>
  <% }); %>
<% } else { %>
  <tr>
    <td colspan="6">Nenhuma entrega cadastrada.</td>
  </tr>
<% } %>
        </tbody>
    </table>
</div>